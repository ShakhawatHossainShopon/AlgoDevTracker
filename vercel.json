{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/public/index.html", "destination": "/", "permanent": false },
    { "source": "/public", "destination": "/", "permanent": false },
    { "source": "/public/(.*)", "destination": "/$1", "permanent": false }
  ]
}
